# PropMange Production Environment Variables
# Copy to .env and fill in.

# --- Domains ---
# UI_DOMAIN: your Cloudflare Pages hostname (no https://)
UI_DOMAIN=prop-mange.example.com
# API_DOMAIN: public hostname for the Spring Boot API gateway (served by Caddy)
API_DOMAIN=api.prop-mange.example.com
# AUTH_DOMAIN: public hostname for the Authentik OIDC provider (served by Caddy)
AUTH_DOMAIN=auth.prop-mange.example.com

# Derived values are computed in docker-compose.yml from the above — do not set them here.
# CORS_ALLOWED_ORIGIN  →  https://${UI_DOMAIN}
# AUTHENTIK_HOST       →  https://${AUTH_DOMAIN}
# AUTH_ISSUER_URI      →  https://${AUTH_DOMAIN}/application/o/prop-manager/
# AUTH_LOGOUT_URL      →  https://${AUTH_DOMAIN}/application/o/prop-manager/end-session/

# --- Cloudflare Tunnel ---
# Get this from the Cloudflare Dashboard (Zero Trust > Networks > Tunnels)
# Configure two Public Hostnames in the tunnel:
#   API_DOMAIN  → http://caddy:80
#   AUTH_DOMAIN → http://caddy:80
TUNNEL_TOKEN=

# --- Postgres ---
# One password used for 'postgres', 'propmanager', and 'authentik' DB users.
# Generate: openssl rand -base64 36 | tr -d '\n'
POSTGRES_PASSWORD=

# --- Authentik ---
# Generate: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=
# Pin Authentik version to avoid unexpected upgrades breaking the stack.
AUTHENTIK_TAG=2025.4.4

# --- Mail (Optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@propmanager.com
