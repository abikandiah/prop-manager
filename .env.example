# Copy this file to .env and fill in the values before running docker compose.

# --- PostgreSQL ---
# Used for all DB users (postgres superuser, propmanager, logto).
# Must be URL-safe — use: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Domains ---
# API domain (routed via Cloudflare Tunnel → Caddy → Spring Boot)
API_DOMAIN=api.example.com
# Logto OIDC domain (routed via Cloudflare Tunnel → Caddy → Logto core :3001)
AUTH_DOMAIN=auth.example.com
# Frontend UI domain (Cloudflare Pages)
UI_DOMAIN=app.example.com
# Logto API resource identifier (must match VITE_OIDC_RESOURCE on the frontend).
# Optional: defaults to https://${API_DOMAIN}. Set it only if your Logto API resource uses a different identifier.
# AUTH_AUDIENCE=

# --- Cloudflare Tunnel ---
TUNNEL_TOKEN=

# --- Mail (Resend recommended) ---
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
