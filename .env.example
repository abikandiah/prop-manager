# PropMange Production Environment Variables
# Copy to .env and fill in.

# --- Domain & Security ---
# DOMAIN: the public hostname of your API (served by Caddy via Cloudflare Tunnel)
DOMAIN=api.example.com
# CORS_ALLOWED_ORIGIN: your Cloudflare Pages URL (sent as Access-Control-Allow-Origin by the Spring Boot app)
CORS_ALLOWED_ORIGIN=https://propmanager.pages.dev

# --- Cloudflare Tunnel ---
# Get this from the Cloudflare Dashboard (Zero Trust > Networks > Tunnels)
# The tunnel should be configured to forward traffic to http://caddy:80
TUNNEL_TOKEN=

# --- Postgres ---
# One password used for 'postgres', 'propmanager', and 'authentik' DB users.
# Generate: openssl rand -base64 36 | tr -d '\n'
POSTGRES_PASSWORD=

# --- Authentik ---
# Generate: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=
# Pin Authentik version to avoid unexpected upgrades breaking the stack.
AUTHENTIK_TAG=2025.4.4

# --- PropMange API (Set after initial Authentik setup) ---
# External issuer URI — must match AUTHENTIK_HOST (https://${DOMAIN}).
# Format: https://<DOMAIN>/application/o/<provider-slug>/
# This must match the 'iss' claim in JWTs issued by Authentik.
AUTH_ISSUER_URI=https://api.example.com/application/o/prop-manager/
# Authentik end-session URL — returned by POST /api/logout so the frontend can redirect the user
AUTH_LOGOUT_URL=https://api.example.com/application/o/prop-manager/end-session/

# --- Mail (Optional) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@propmanager.com
