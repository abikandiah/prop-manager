{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Attach to Backend (5005)",
      "request": "attach",
      "hostName": "localhost",
      "port": 5005,
      "projectName": "prop-manager"
    },
    {
      "type": "java",
      "name": "Spring: Dev (Local)",
      "request": "launch",
      "mainClass": "com.akandiah.propmanager.PropManagerApplication",
      "projectName": "prop-manager",
      "vmArgs": "-Dspring.profiles.active=dev"
    },
    {
      "type": "java",
      "name": "Spring: Dev OIDC (homelab Logto)",
      "request": "launch",
      "mainClass": "com.akandiah.propmanager.PropManagerApplication",
      "projectName": "prop-manager",
      "vmArgs": "-Dspring.profiles.active=dev-oidc"
    }
  ]
}
