# CORS is handled entirely by the Spring Boot app — do not add CORS headers here.

# --- AUTHENTIK IDP ---
{$AUTH_DOMAIN} {
	reverse_proxy authentik:9000
}

# --- API GATEWAY ---
{$API_DOMAIN} {
	# 1. PUBLIC: Authentik outpost endpoints (forward auth callback, login redirect)
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik:9000
	}

	# 2. CORS preflight — bypass auth, let Spring Boot handle OPTIONS
	@preflight {
		method OPTIONS
		path /api/*
		path /swagger-ui*
		path /actuator/*
		path /v3/api-docs*
	}
	handle @preflight {
		reverse_proxy app:8080
	}

	# 3. PUBLIC: Health check (no auth required)
	handle /actuator/health* {
		reverse_proxy app:8080
	}

	# 4. PROTECTED: API and internal tools
	@protected {
		path /api/*
		path /swagger-ui*
		path /actuator/metrics*
		path /actuator/prometheus*
		path /v3/api-docs*
	}
	handle @protected {
		forward_auth authentik:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Name X-Authentik-Uid X-Authentik-Jwt
			trusted_proxies private_ranges
		}

		handle /api/* {
			reverse_proxy app:8080 {
				header_up Authorization "Bearer {header.X-Authentik-Jwt}"
			}
		}

		handle {
			reverse_proxy app:8080
		}
	}

	# 5. Root
	handle / {
		respond "PropMange API Gateway is running." 200
	}

	# 6. SECURITY HEADERS
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer-when-downgrade
		-Server
	}
}
