# CORS is handled entirely by the Spring Boot app — do not add CORS headers here.

# --- LOCAL ACCESS (bypasses Cloudflare Tunnel; no forward auth required) ---
# API: http://localhost/api/...   Logto admin console: http://localhost:3002
http://localhost {
	handle /api/* {
		reverse_proxy app:8080
	}

	handle /swagger-ui* {
		reverse_proxy app:8080
	}

	handle /v3/api-docs* {
		reverse_proxy app:8080
	}

	handle /actuator/* {
		reverse_proxy app:8080
	}

	handle / {
		respond "PropMange API Gateway is running (local)." 200
	}
}


# --- LOGTO OIDC ---
# http:// prefix binds to :80 — TLS is terminated by Cloudflare Tunnel.
http://{$AUTH_DOMAIN} {
	reverse_proxy logto:3001 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

# --- API GATEWAY ---
http://{$API_DOMAIN} {
	# 1. CORS preflight — bypass auth, let Spring Boot handle OPTIONS
	@preflight {
		method OPTIONS
		path /api/*
		path /swagger-ui*
		path /actuator/*
		path /v3/api-docs*
	}
	handle @preflight {
		reverse_proxy app:8080
	}

	# 3. PUBLIC: Health check (no auth required)
	handle /actuator/health* {
		reverse_proxy app:8080
	}

	# 4. API and internal tools — auth enforced by Spring Boot JWT validation
	handle /api/* {
		reverse_proxy app:8080
	}

	handle /swagger-ui* {
		reverse_proxy app:8080
	}

	handle /actuator/* {
		reverse_proxy app:8080
	}

	handle /v3/api-docs* {
		reverse_proxy app:8080
	}

	# 5. Root
	handle / {
		respond "PropMange API Gateway is running." 200
	}

	# 6. SECURITY HEADERS
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer-when-downgrade
		-Server
	}
}
